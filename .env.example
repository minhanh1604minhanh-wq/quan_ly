# Supabase (SERVER ONLY)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_KEY

# Admin login — set real values only in Vercel/local .env
SUPERADMIN_USERNAME="Nguyễn Minh Anh"
SUPERADMIN_PASSWORD=CHANGE_ME_TO_THE_PASSWORD_PROVIDED_BY_OWNER
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Event ingestion from character-site backends
ANALYTICS_INGEST_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

# OpenAI (SERVER ONLY)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini

# Optional
PORT=3000
